<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

  <application>
    <service
      android:name="expo.modules.trikiaccessibility.TrikiAccessibilityService"
      android:label="Triki Controller"
      android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
      android:exported="true">
      <intent-filter>
        <action android:name="android.accessibilityservice.AccessibilityService" />
      </intent-filter>
      <meta-data
        android:name="android.accessibilityservice"
        android:resource="@xml/triki_accessibility_service" />
    </service>

    <service
      android:name="expo.modules.trikiaccessibility.TrikiKeepAliveService"
      android:exported="false"
      android:foregroundServiceType="connectedDevice" />
  </application>
</manifest>
